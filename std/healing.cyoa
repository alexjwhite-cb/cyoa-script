# Standard library: healing effects
# These are reusable effect blocks that can be used by any story.
# Import via: import "std/healing"

effect healing_potion:
  +20 hp
  You drink a healing potion. You recover 20 HP.

effect minor_heal:
  +10 hp
  You take a moment to rest. You recover 10 HP.

effect full_restore:
  You feel completely revitalized.
  +999999 hp
